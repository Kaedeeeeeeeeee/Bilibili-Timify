{
  "manifest_version": 3,
  "name": "Bilibili Timify",
  "version": "0.1.0",
  "description": "把 B 站封面里所有的人脸都替换成影视飓风 Tim 的脸（自动缩放、旋转、镜像对齐）",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.bilibili.com/*",
    "*://*.hdslb.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://www.bilibili.com/*"],
      "js": ["lib/face-api.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "models/*",
        "tim-face.png"
      ],
      "matches": ["*://*.bilibili.com/*"]
    }
  ]
}
